# Copie este arquivo para .env e preencha com os valores reais.
# O .env nunca deve ser commitado no Git.

# Caminho do banco SQLite (opcional — usa backend/database/sweetcake.db por padrão)
DATABASE_PATH=

# Número oficial de WhatsApp da Sweet Cake, só dígitos com DDI+DDD (ex: 5591985396256)
WHATSAPP_NUMBER=

# Origem do front-end autorizada a consumir a API (ex: http://localhost:5500)
# Use * apenas em desenvolvimento.
FRONTEND_ORIGIN=*

# development | production
FLASK_ENV=development

# Chave usada internamente pelo Flask (gere uma string aleatória em produção)
SECRET_KEY=
